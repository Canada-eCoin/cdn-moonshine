<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="colorControlActivated">@color/secondary_dark</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:background">@drawable/background_splash</item>
    </style>

    <!-- react-native-bootsplash 7: the theme the splash is inflated from. The library
         provides Theme.BootSplash; the background comes from our existing color. -->
    <style name="BootTheme" parent="Theme.BootSplash">
        <item name="darkContentBarsStyle">true</item>
    </style>

</resources>
