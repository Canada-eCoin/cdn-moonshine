# Modernised for the React Native version this repo actually runs (0.78.x).
#
# What was wrong before (all of it fatal to `pod install`):
#   * `use_flipper!` / `flipper_post_install` — Flipper was removed from React Native
#     in 0.73; the helpers no longer exist, so the Podfile raised `undefined method`
#     before resolving anything.
#   * `platform :ios, '10.0'` — React Native 0.78 requires iOS 15.1
#     (`Helpers::Constants.min_ios_version_supported`), so nothing could resolve.
#   * `config["reactNativePath"]` — `use_native_modules!` returns a hash with SYMBOL
#     keys (`{ :reactNativePath => ... }`), so this evaluated to nil.
#   * No `react_native_post_install`, which is what applies the RN build-setting
#     patches (deployment targets, `USE_HERMES`, new-architecture flags) to each pod.
#
# Podfile.lock was also deleted alongside this: it pinned React 0.63.3 and pods from
# the pre-fork upstream (`react-native-camera`, `react-native-blur`,
# `react-native-netinfo` 5.x) that no longer correspond to package.json at all.

require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, min_ios_version_supported

prepare_react_native_project!

# Optional: `USE_FRAMEWORKS=dynamic bundle exec pod install`
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'moonshine' do
  config = use_native_modules!

  # INTERIM: iOS runs on the LEGACY architecture, deliberately, and this is the only
  # thing standing between the app and a launch crash.
  #
  # The iOS entry point is still the React Native 0.63-era one — RCTBridge + RCTRootView
  # in AppDelegate.mm. Under the new architecture RNBootSplash requires a surface-hosting
  # root view and dies on launch:
  #
  #   *** Terminating app due to uncaught exception 'NSInvalidArgumentException',
  #       reason: '-[RCTRootView disableActivityIndicatorAutoHide:]: unrecognized selector'
  #
  # (upstream zoontek/react-native-bootsplash#794 — and 7.3.4 still requires the
  # surface-hosting view, so upgrading the library does not help). Found by the simulator
  # smoke test on 2026-10-10, having been latent since the June 2025 upgrade turned the new
  # architecture on without touching the entry point.
  #
  # The legacy architecture is what this entry point actually implements, so turning it off
  # makes the two consistent. Android keeps the new architecture — its MainApplication.kt is
  # the modern one. Re-enable here once AppDelegate is migrated to RCTReactNativeFactory.
  use_react_native!(
    :path => config[:reactNativePath],
    # Absolute path to the application root, used by codegen for the new architecture.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => false
  )

  target 'moonshineTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end

# The tvOS targets are still in the Xcode project but carry no React pods — the same
# as before this change. Nothing here builds tvOS; leave the block so `pod install`
# still covers the workspace.
target 'moonshine-tvOS' do
  target 'moonshine-tvOSTests' do
    inherit! :search_paths
  end
end
