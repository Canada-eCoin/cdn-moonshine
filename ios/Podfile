# Modernised for the React Native version this repo actually runs (0.78.x).
#
# What was wrong before (all of it fatal to `pod install`):
#   * `use_flipper!` / `flipper_post_install` — Flipper was removed from React Native
#     in 0.73; the helpers no longer exist, so the Podfile raised `undefined method`
#     before resolving anything.
#   * `platform :ios, '10.0'` — React Native 0.78 requires iOS 15.1
#     (`Helpers::Constants.min_ios_version_supported`), so nothing could resolve.
#   * `config["reactNativePath"]` — `use_native_modules!` returns a hash with SYMBOL
#     keys (`{ :reactNativePath => ... }`), so this evaluated to nil.
#   * No `react_native_post_install`, which is what applies the RN build-setting
#     patches (deployment targets, `USE_HERMES`, new-architecture flags) to each pod.
#
# Podfile.lock was also deleted alongside this: it pinned React 0.63.3 and pods from
# the pre-fork upstream (`react-native-camera`, `react-native-blur`,
# `react-native-netinfo` 5.x) that no longer correspond to package.json at all.

require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, min_ios_version_supported

prepare_react_native_project!

# Optional: `USE_FRAMEWORKS=dynamic bundle exec pod install`
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'moonshine' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # Absolute path to the application root, used by codegen for the new architecture.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'moonshineTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end

# The tvOS targets are still in the Xcode project but carry no React pods — the same
# as before this change. Nothing here builds tvOS; leave the block so `pod install`
# still covers the workspace.
target 'moonshine-tvOS' do
  target 'moonshine-tvOSTests' do
    inherit! :search_paths
  end
end
